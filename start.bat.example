@echo off
chcp 65001 >nul
cd /d "%~dp0"
title Todoister — Tasks
REM Copy this file to start.bat, then create the environment once:
REM   py -3.14 -m venv .venv
REM   .venv\Scripts\python.exe -m pip install -r requirements.txt
REM Save the copy as UTF-8 with BOM and CRLF line endings — LF breaks it.
"%~dp0.venv\Scripts\python.exe" app.py
echo.
echo Server stopped. Press any key to close.
pause >nul
