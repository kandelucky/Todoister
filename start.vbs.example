' Todoister — silent launcher (no console window)
' Runs the venv's pythonw.exe, resolved from this script's own folder,
' so the project can be moved without editing this file.
' Create the environment once:
'   py -3.14 -m venv .venv
'   .venv\Scripts\python.exe -m pip install -r requirements.txt
' Crash diagnostics → app.log
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
base = fso.GetParentFolderName(WScript.ScriptFullName)
sh.CurrentDirectory = base
sh.Run """" & base & "\.venv\Scripts\pythonw.exe"" app.py", 0, False
